# =============================================================================
# audit-hub — .dockerignore
# Prevents unnecessary files from entering the Docker build context.
# A smaller context = faster builds.
# =============================================================================

# Dependencies (reinstalled inside the image)
node_modules/

# Compiled output (generated by builder stage)
dist/

# Environment files — NEVER bake secrets into images
.env
.env.*

# Dev tooling
.devcontainer/
.vscode/
.idea/

# Git history
.git/
.gitignore

# Test artifacts
coverage/

# Docker files themselves (don't need to copy these into the image)
docker-compose*

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
