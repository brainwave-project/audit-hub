{
  "name": "audit-hub",
  "version": "1.0.0",
  "description": "Audit trail microservice — consumes domain events from Kafka and exposes activity query APIs.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --watch src --ext ts --exec tsx src/index.ts",
    "test": "echo \"No tests specified\" && exit 0",
    "lint": "eslint . --ext .ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@brainwave-project/core": "^1.0.0",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@prisma/client": "^5.14.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "kafkajs": "^2.2.4",
    "prisma": "^5.14.0",
    "pino": "^9.0.0",
    "prom-client": "^15.1.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^8.0.0",
    "nodemon": "^3.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brainwave-project/audit-hub.git"
  },
  "keywords": ["audit", "kafka", "consumer", "activity"],
  "author": "Ahmad Awad",
  "license": "MIT"
}
